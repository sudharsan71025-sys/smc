# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/smc_showroom
MONGODB_DB_NAME=smc_showroom

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars!
JWT_EXPIRES_IN=7d

# Initial Admin Account (Seeding)
ADMIN_NAME=SMC Admin
ADMIN_EMAIL=javix@gmail.com
ADMIN_PASSWORD=javix2026

# Storage - MongoDB GridFS is the exclusive storage engine (Zero external services)
GRIDFS_BUCKET_NAME=models

# File Upload Constraints
MAX_FILE_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10
