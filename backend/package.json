{
  "name": "backend",
  "version": "1.0.0",
  "description": "AR/VR Door & Window Showroom REST API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:db": "tsx src/utils/verify-db.ts",
    "seed:admin": "tsx src/utils/seed-admin.ts",
    "test:auth": "tsx src/utils/test-auth.ts",
    "test:admin": "tsx src/utils/test-admin-products.ts",
    "test:mongo": "tsx src/utils/test-mongodb-integration.ts",
    "seed:models": "tsx src/utils/generate-sample-models.ts",
    "test:3d": "tsx src/utils/test-3d-viewer.ts",
    "test:android-ar": "tsx src/utils/test-android-ar.ts",
    "test:native-ar": "tsx src/utils/test-native-ar.ts",
    "test:ios-ar": "tsx src/utils/test-ios-ar.ts",
    "test:e2e": "tsx src/utils/test-e2e-integration.ts",
    "test:playwright": "tsx src/utils/test-playwright-e2e.ts",
    "test:qa": "tsx src/utils/verify-all-qa.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "mongoose",
    "ar",
    "vr",
    "showroom"
  ],
  "author": "SMC Architecture Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "mongodb-memory-server": "^10.1.3",
    "playwright-core": "^1.65.0",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
