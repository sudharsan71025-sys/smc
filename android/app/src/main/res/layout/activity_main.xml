<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvBrandSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ARCHITECTURAL AR SYSTEM"
        android:textColor="@color/primary_gold"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMC Doors &amp; Windows"
        android:textColor="@color/text_light"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/tvDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Native Google ARCore client for real-world physical wall anchoring at 1:1 scale."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@id/btnLaunchSample"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLaunchSample"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Launch AR Showcase"
        android:textColor="#202020"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:backgroundTint="@color/primary_gold"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Waiting for website deep link or manual launch..."
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnLaunchSample"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

