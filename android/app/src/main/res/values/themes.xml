<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SMCDoorWindowAR" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_gold</item>
        <item name="colorPrimaryVariant">@color/primary_gold_dark</item>
        <item name="colorOnPrimary">#202020</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
    </style>

    <style name="Theme.SMCDoorWindowAR.Fullscreen" parent="Theme.SMCDoorWindowAR">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>

